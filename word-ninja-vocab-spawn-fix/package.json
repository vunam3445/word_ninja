{
  "name": "word-ninja-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Word Ninja 2D English-learning RPG - web frontend, PostgreSQL backend, and Capacitor Android packaging",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "import:vocab": "node scripts/import-vocabulary.js",
    "migrate:old-vocab": "node scripts/migrate-old-vocabulary.js",
    "repair:vocab": "node scripts/repair-vocabulary.js",
    "audit:vocab": "node scripts/audit-vocabulary.js",
    "restore:vocab": "node scripts/restore-vocabulary.js",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:configure": "node scripts/configure-android.mjs",
    "android:dictionary": "node scripts/download-dictionary.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "phaser": "3.90.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
